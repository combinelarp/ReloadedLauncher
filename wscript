def options(opt):
    opt.load('compiler_cxx')
    opt.load('compiler_c')


# ---------------------------------------------------------------------------
# Toolchain detection
# ---------------------------------------------------------------------------
def _is_msvc(env):
    compiler = (env.CXX_NAME or '').lower()
    return bool(env.MSVC_VERSION) or compiler in ('msvc', 'clang-cl')


# ---------------------------------------------------------------------------
# Flag setup (runs during `waf configure`)
# ---------------------------------------------------------------------------
def _setup_gcc(conf):
    conf.env.append_unique('CXXFLAGS', [
        '-std=c++17', '-Wall',
        '-DWIN32_LEAN_AND_MEAN', '-D_CRT_SECURE_NO_WARNINGS', '-DZIP_STATIC',
    ])
    conf.env.append_unique('CFLAGS', [
        '-std=gnu11', '-Wall',
        '-DWIN32_LEAN_AND_MEAN', '-D_CRT_SECURE_NO_WARNINGS', '-DZIP_STATIC',
    ])
    # -mwindows == /SUBSYSTEM:WINDOWS + /ENTRY:WinMainCRTStartup
    conf.env.append_unique('LINKFLAGS', ['-mwindows'])

    # Silence "unknown pragma" warnings for MSVC-only
    # `#pragma comment(lib, ...)` seen in zip_crypto_win.c.
    conf.env.append_unique('CXXFLAGS', ['-Wno-unknown-pragmas'])
    conf.env.append_unique('CFLAGS', ['-Wno-unknown-pragmas'])

    # waf's built-in tool: finds `windres`, stores WINDRES in env,
    # registers the @extension('.rc') handler.
    conf.load('winres')
    if not getattr(conf.env, 'WINDRES', None):
        conf.find_program('windres', var='WINDRES')

    # <<< NEW >>> Provide MinGW shims for the Annex-K functions that
    # libzip's vendored config.h wrongly believes are available.
    _install_mingw_compat(conf)


def _install_mingw_compat(conf):
    """Emit a small header providing MinGW-friendly replacements for the
    handful of Annex-K functions libzip's config.h claims exist but
    MinGW-w64 doesn't actually ship. Injected via -include so it is
    visible before every translation unit (including config.h)."""
    shim_src = r'''
/* Auto-generated by wscript -- do not edit. */
#ifdef __MINGW32__
#include <stdio.h>
#include <string.h>
#include <stdarg.h>

/* MinGW-w64 UCRT provides _snprintf_s, not Annex-K snprintf_s. */
static inline int
snprintf_s(char *buf, size_t sz, const char *fmt, ...) {
    va_list ap;
    int r;
    va_start(ap, fmt);
    r = vsnprintf(buf, sz, fmt, ap);
    va_end(ap);
    return r;
}

/* MinGW-w64 UCRT provides strerror_s, not Annex-K strerrorlen_s. */
static inline size_t
strerrorlen_s(int errnum) {
    const char *s = strerror(errnum);
    return s ? strlen(s) : 0;
}
#endif
'''
    shim = conf.path.get_bld().make_node('libzip_mingw_compat.h')
    shim.write(shim_src)
    conf.env.append_unique('CFLAGS',   ['-include', shim.abspath()])
    conf.env.append_unique('CXXFLAGS', ['-include', shim.abspath()])

def _setup_msvc(conf):
    conf.env.append_unique('CXXFLAGS', [
        '/std:c++17', '/W3', '/DWIN32_LEAN_AND_MEAN',
        '/D_CRT_SECURE_NO_WARNINGS', '/EHsc', '/DZIP_STATIC',
    ])
    conf.env.append_unique('CFLAGS', [
        '/std:c11', '/W3', '/DWIN32_LEAN_AND_MEAN',
        '/D_CRT_SECURE_NO_WARNINGS', '/DZIP_STATIC',
    ])
    conf.env.append_unique('LINKFLAGS', [
        '/SUBSYSTEM:WINDOWS', '/ENTRY:WinMainCRTStartup',
    ])


def configure(conf):
    conf.load('compiler_cxx')
    conf.load('compiler_c')
    if _is_msvc(conf.env):
        _setup_msvc(conf)
    else:
        _setup_gcc(conf)

    conf.env.LIB = [
        'gdiplus', 'wininet', 'shell32', 'ole32', 'shlwapi',
        'ws2_32', 'advapi32', 'user32', 'gdi32', 'bcrypt',
    ]


# ---------------------------------------------------------------------------
# Build (runs during `waf build`)
# ---------------------------------------------------------------------------
def build(bld):
    # Importing this module registers the @extension('.rc') handler in the
    # current process. It must run inside build() because configure() and
    # build() are two separate waf invocations.
