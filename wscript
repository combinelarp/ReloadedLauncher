        target='libzip',
        source=libzip_src,
        includes=['src/libzip/lib', 'src/zlib'],
        use=['zlib'],
        defines=[
            'ZIP_STATIC',
            # Your MinGW-w64/UCRT toolchain genuinely provides ftello()/
            # fseeko(), but libzip's vendored config.h doesn't know that
            # (it predates this toolchain upgrade). Force the correct
            # values so compat.h's fallback macros don't fire and collide
            # with the real UCRT declarations.
            #
            # NOTE: HAVE_SNPRINTF_S / HAVE__SNWPRINTF_S / HAVE_STRERROR_S
            # are NOT added here on purpose -- config.h already (wrongly)
            # defines them, assuming MSVC-style Annex-K functions that
            # MinGW-w64 doesn't actually provide under those names. Fix
            # those by editing config.h directly (see note below), not
            # here -- defining them again here only produces duplicate
            # "redefined" warnings and doesn't fix the real problem.
            'HAVE_FTELLO',
            'HAVE_FSEEKO',
        ],
        features=['c', 'cstlib'],
    )

    # Recurse into source subdirectories
    bld.recurse('src')

    # Link all objects into the executable
    bld.program(
        target='BlockmanGO',
        source=bld.path.ant_glob('src/**/*.cpp') + ['src/resource.rc'],
        includes=['.', 'src', 'src/libzip/lib', 'src/zlib'],
        use=['libzip', 'zlib'],
    )
